  },
  "env": {
    "CLAUDE_HUD_ALLOW_EXTRA_CMD": "1",
    "HIMMEL_REPO": "/opt/himmel",
    "LUNA_VAULT_PATH": "/opt/luna-vault",
    "HANDOVER_DIR": "/opt/luna-vault/handovers"
  }
