{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/scripts/hooks/auto-approve-safe-bash.sh\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/auto-approve-safe-bash.sh\"; else echo \"himmel: hook script missing ($CLAUDE_PROJECT_DIR/scripts/hooks/auto-approve-safe-bash.sh) -- re-run the install (himmelctl install) or unwire it (himmelctl uninstall)\" >&2; exit 0; fi"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-edit-on-main.sh\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-edit-on-main.sh\"; else echo \"himmel: hook script missing ($CLAUDE_PROJECT_DIR/scripts/hooks/block-edit-on-main.sh) -- re-run the install (himmelctl install) or unwire it (himmelctl uninstall)\" >&2; exit 0; fi"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-read-secrets.sh\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-read-secrets.sh\"; else echo \"himmel: hook script missing ($CLAUDE_PROJECT_DIR/scripts/hooks/block-read-secrets.sh) -- re-run the install (himmelctl install) or unwire it (himmelctl uninstall)\" >&2; exit 0; fi"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -r \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-unresolved-cr-merge.sh\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/block-unresolved-cr-merge.sh\"; else echo \"himmel: merge gate missing -- re-run adopt.sh\" >&2; exit 2; fi",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"/opt/himmel/scripts/hooks/inject-initiative.sh\" ]; then bash \"/opt/himmel/scripts/hooks/inject-initiative.sh\"; else echo \"himmel: hook script missing (/opt/himmel/scripts/hooks/inject-initiative.sh) -- re-run the install (himmelctl install) or unwire it (himmelctl uninstall)\" >&2; exit 0; fi"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"/opt/himmel/scripts/hooks/end-session-wiki.sh\" ]; then bash \"/opt/himmel/scripts/hooks/end-session-wiki.sh\"; else echo \"himmel: hook script missing (/opt/himmel/scripts/hooks/end-session-wiki.sh) -- re-run the install (himmelctl install) or unwire it (himmelctl uninstall)\" >&2; exit 0; fi",
            "shell": "bash",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "url",
        "url": "https://github.com/kepano/obsidian-skills.git"
      },
      "autoUpdate": true
    },
    "himmel": {
      "source": {
        "source": "directory",
        "path": "/opt/himmel/marketplace"
      },
      "autoUpdate": true
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      },
      "autoUpdate": true
    },
    "openai-codex": {
      "source": {
        "source": "url",
        "url": "https://github.com/openai/codex-plugin-cc.git"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
