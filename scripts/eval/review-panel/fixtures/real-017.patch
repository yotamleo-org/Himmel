+# g4_bare_brace WORD: does WORD hold a `{` outside single quotes, double
+# quotes and backslash escapes, i.e. one the shell would brace-expand?
+g4_bare_brace() {
+    local s="$1" c q="" i bs=$'\\'
+    for ((i = 0; i < ${#s}; i++)); do
+        c="${s:i:1}"
+        if [ "$q" = "'" ]; then
+            if [ "$c" = "'" ]; then q=""; fi
+        elif [ "$q" = '"' ]; then
+            if [ "$c" = "$bs" ]; then i=$((i + 1))
+            elif [ "$c" = '"' ]; then q=""; fi
+        else
+            case "$c" in
+                "$bs") i=$((i + 1)) ;;
+                "'"|'"') q="$c" ;;
+                '{') return 0 ;;
+            esac
+        fi
+    done
+    return 1
+}
