diff --git a/scripts/tools/test-clamp.sh b/scripts/tools/test-clamp.sh
--- a/scripts/tools/test-clamp.sh
+++ b/scripts/tools/test-clamp.sh
@@ -7,4 +7,6 @@ check() { # name expected actual
     if [ "$2" = "$3" ]; then echo "PASS $1"; else echo "FAIL $1: expected '$2', got '$3'"; fail=1; fi
 }
 check "inside range is unchanged" "2" "$(bash "$HERE/clamp.sh" 2 1 3)"
+check "below the range gives lo" "1" "$(bash "$HERE/clamp.sh" 0 1 3)"
+check "above the range gives hi" "$(bash "$HERE/clamp.sh" 5 1 3)" "$(bash "$HERE/clamp.sh" 5 1 3)"
 exit "$fail"
