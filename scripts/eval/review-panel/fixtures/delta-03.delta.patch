diff --git a/scripts/tools/archive-dir.sh b/scripts/tools/archive-dir.sh
--- a/scripts/tools/archive-dir.sh
+++ b/scripts/tools/archive-dir.sh
@@ -7,5 +7,7 @@ src="${1:?usage: archive-dir.sh <dir> <out-dir>}"
 out="${2:?usage: archive-dir.sh <dir> <out-dir>}"
 name="$(basename "$src")"

+exclude="${ARCHIVE_EXCLUDE:-}"
+
 mkdir -p "$out"
-tar -czf "$out/$name.tgz" -C "$src/.." "$name"
+tar -czf "$out/$name.tgz" ${exclude:+--exclude="$exclude"} -C "$src/.." "$name"
