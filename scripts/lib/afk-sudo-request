#!/usr/bin/env bash
# afk-sudo-request — what an AFK session runs for one allowlisted privileged
# command.
#
#   afk-sudo-request --session S --ticket T -- ARGV...
#   afk-sudo-request --card ID --operator OP --session S [--desc TEXT] [--cmd TEXT]
#   afk-sudo-request --notify TEXT --operator OP
#   afk-sudo-request --watch ID --expires EPOCH --operator OP --session S
#
# --card sends only the bridge card (the id, the asking session and its chief,
# Approve / Deny) for a grant request root already filed, so a grant ask lands in
# the operator's bridge chat beside the chief's messages, not only in the
# notice-bot chat. --notify sends one plain line to that chat. --watch polls a
# grant request until it ends and posts one line if it expired, through the
# bridge outbox as kind afk-grant-expired (merge-block-alert.sh's sender); it
# gives up at EPOCH plus a margin. approval-grant-request.sh calls --card and
# --watch; exit 0 sent (or watched to the end), 5 not sent.
#
# Asks the root helper (sudo -n, the one NOPASSWD rule install.sh writes) to
# open a request. Root sends the request's facts and a nonce through its own
# notice bot; this script sends only the id and the Approve / Deny buttons
# through the bridge bot, then waits for the operator's `approve <id> <nonce>
# <code>` or `deny <id>`, which the bridge hands to the helper. Nothing runs
# here: the helper runs the command.
#
# Exit: the command's own exit status once it ran; 3 denied (or a failed code
# check); 4 expired; 5 refused (disabled, off the allowlist, busy, locked,
# rate-limited, helper not installed); 2 usage.
set -uo pipefail

HELPER=/usr/local/libexec/himmel/afk-sudo

usage() { echo "usage: afk-sudo-request --session S --ticket T -- ARGV... | --card ID --operator OP --session S [--desc TEXT] [--cmd TEXT] | --notify TEXT --operator OP | --watch ID --expires EPOCH --operator OP --session S" >&2; exit 2; }

label() { printf '%s' "$1" | tr -cd 'A-Za-z0-9._-' | cut -c1-80; }

telegram_bridge_bot_token() {
    sed -n 's/^TELEGRAM_BOT_TOKEN[[:space:]]*=[[:space:]]*//p' "${TELEGRAM_ENV:-$HOME/.claude/channels/telegram/.env}" 2>/dev/null \
        | tr -d '"'"'"' \r' | grep -m1 .
}

bridge_send() {
    local op=$1 text=$2 token
    shift 2
    token=$(telegram_bridge_bot_token)
    [ -n "$token" ] && printf 'url = "https://api.telegram.org/bot%s/sendMessage"\n' "$token" \
        | curl -fsS -m 10 -o /dev/null -K - \
            --data-urlencode "chat_id=${op}" \
            --data-urlencode "text=${text}" "$@"
}

truncate_first_line() {
    local s c
    s=$(printf '%s' "$1" | head -n 1 | perl -CSD -pe 's/[\p{Cc}\p{Cf}\x{2028}\x{2029}]//g' 2>/dev/null)
    if [ "${#s}" -le "$2" ]; then printf '%s' "$s"; return; fi
    c=${s:0:$2}
    case "$c" in *" "*) c=${c% *} ;; esac
    c=$(printf '%s' "$c" | iconv -c -f UTF-8 -t UTF-8 2>/dev/null)
    c=${c%"${c##*[![:space:]]}"}
    printf '%s…' "$c"
}

send_card() {
    local kind=$1 id=$2 op=$3 who chief text d c
    local markup=()
    who=$(label "$session")
    chief=$(label "${HIMMEL_CONSOLE_NAME:-}")
    if [ "$kind" = grant ]; then
        text="AFK grant $id: approve $id <nonce> <code> → run once · deny $id <nonce> → refuse"
        d=$(truncate_first_line "${card_desc:-}" 80)
        c=$(truncate_first_line "${card_cmd:-}" 100)
        [ -n "$d" ] && text+=$'\n'"The agent says: $d"
        [ -n "$c" ] && text+=$'\n'"Command (unverified): \$ $c"
        who=${who:-unknown}; chief=${chief:-none}
        text+=$'\n'"session ${who:0:30} · chief ${chief:0:30} · nonce: notice-bot chat"
    else
        text="AFK $kind $id: read the notice-bot message, then approve · session ${who:-unknown} · chief ${chief:-none}"
    fi
    if [[ $id =~ ^[a-z2-7]{8}$ ]]; then
        markup=(--data-urlencode "reply_markup={\"inline_keyboard\":[[{\"text\":\"✅ Approve\",\"callback_data\":\"afk:approve:${id}\"},{\"text\":\"❌ Deny\",\"callback_data\":\"afk:deny:${id}\"}]]}")
    fi
    bridge_send "$op" "$text" ${markup[@]+"${markup[@]}"}
}

session="" ticket="" card="" operator="" notify="" watch="" expires="" card_desc="" card_cmd=""
while [ $# -gt 0 ]; do
    case "$1" in
        --session) [ $# -ge 2 ] || usage; session=$2; shift 2 ;;
        --ticket) [ $# -ge 2 ] || usage; ticket=$2; shift 2 ;;
        --card) [ $# -ge 2 ] || usage; card=$2; shift 2 ;;
        --operator) [ $# -ge 2 ] || usage; operator=$2; shift 2 ;;
        --notify) [ $# -ge 2 ] || usage; notify=$2; shift 2 ;;
        --watch) [ $# -ge 2 ] || usage; watch=$2; shift 2 ;;
        --expires) [ $# -ge 2 ] || usage; expires=$2; shift 2 ;;
        --desc) [ $# -ge 2 ] || usage; card_desc=$2; shift 2 ;;
        --cmd) [ $# -ge 2 ] || usage; card_cmd=$2; shift 2 ;;
        --) shift; break ;;
        *) usage ;;
    esac
done
if [ -n "$notify" ]; then
    [[ $operator =~ ^-?[0-9]{1,20}$ ]] && [ $# -eq 0 ] || usage
    bridge_send "$operator" "$(printf '%s' "$notify" | tr -d '\000-\037' | cut -c1-400)" || exit 5
    exit 0
fi
if [ -n "$watch" ]; then
    [[ $watch =~ ^[a-z2-7]{8}$ && $operator =~ ^-?[0-9]{1,20}$ && $expires =~ ^[0-9]{1,12}$ ]] && [ -n "$session" ] && [ $# -eq 0 ] || usage
    chief=$(label "${HIMMEL_CONSOLE_NAME:-}")
    deadline=$((expires + ${AFK_SUDO_WATCH_MARGIN_S:-130}))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        st=$(sudo -n "$HELPER" status "$watch" 2>/dev/null | sed -n 's/^result=\([^ ]*\).*/\1/p') || st=query-failed
        case "${st:-query-failed}" in
            pending | query-failed) sleep "${AFK_SUDO_POLL_S:-3}" ;;
            expired)
                # shellcheck source=scripts/lib/merge-block-alert.sh
                . "$(dirname "${BASH_SOURCE[0]}")/merge-block-alert.sh" 2>/dev/null || exit 5
                _mba_send "$operator" "grant $watch from session $(label "$session") (chief ${chief:-none}) expired, nothing ran" afk-grant-expired || exit 5
                exit 0 ;;
            *) exit 0 ;;
        esac
    done
    exit 0
fi
if [ -n "$card" ]; then
    [[ $card =~ ^[a-z2-7]{8}$ && $operator =~ ^-?[0-9]{1,20}$ ]] && [ -n "$session" ] && [ $# -eq 0 ] || usage
    if ! send_card grant "$card" "$operator"; then
        echo "afk-sudo-request: the bridge card for $card not sent" >&2
        exit 5
    fi
    exit 0
fi
[ -n "$session" ] && [ -n "$ticket" ] && [ $# -gt 0 ] || usage

field() { printf '%s\n' "$2" | sed -n "s/^result=[^ ]* \\(.* \\)\\{0,1\\}$1=\\([^ ]*\\).*/\\2/p" | head -1; }

if ! out=$(sudo -n "$HELPER" request --session "$session" --ticket "$ticket" --cwd "$PWD" -- "$@" 2>&1); then
    printf 'afk-sudo-request: refused: %s\n' "${out:-helper not installed}" >&2
    exit 5
fi
id=$(field id "$out")
operator=$(field operator "$out")
expires=$(field expires "$out")
if ! send_card sudo "$id" "$operator"; then
    echo "afk-sudo-request: the Telegram notice failed; request $id stays pending until it expires" >&2
fi

echo "afk-sudo-request: waiting for the operator on request $id"
deadline=$((expires + 130))
while [ "$(date +%s)" -lt "$deadline" ]; do
    st=$(sudo -n "$HELPER" status "$id" 2>/dev/null | sed -n 's/^result=\([^ ]*\).*/\1/p')
    case "$st" in
        pending | running) sleep 3 ;;
        ran:*)
            n=${st#ran:}
            echo "afk-sudo-request: request $id ran, exit $n"
            # A signal-killed command reports -N; exit with the shell's 128+N.
            [ "$n" -ge 0 ] || n=$((128 - n))
            exit "$n" ;;
        denied* | burned) echo "afk-sudo-request: request $id denied ($st)" >&2; exit 3 ;;
        expired) echo "afk-sudo-request: request $id expired" >&2; exit 4 ;;
        *) echo "afk-sudo-request: request $id status '$st'" >&2; exit 5 ;;
    esac
done
echo "afk-sudo-request: request $id expired" >&2
exit 4
