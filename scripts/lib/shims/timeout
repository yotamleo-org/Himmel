#!/usr/bin/env bash
# scripts/lib/shims/timeout — a GNU `timeout` stand-in for hosts with neither
# `timeout` nor `gtimeout` (stock macOS). Put on PATH by scripts/lib/portable-timeout.sh,
# only when no real one exists.
#
# Supports the GNU surface the suites use: [-k DUR|--kill-after=DUR]
# [-s SIG|--signal=SIG] [--preserve-status] [--foreground] [-v] DURATION CMD...
# DURATION is a number with an optional s/m/h/d suffix; 0 means no bound.
# Exit: CMD's status; 124 when the bound fired (137 when -k had to KILL);
# 125 usage; 127 CMD not found. --version prints a line, exit 0, so a
# `--version` probe accepts it.
#
# bash 3.2-safe. CMD runs in its own process group (set -m) and the whole group
# is signalled, like GNU timeout without --foreground; with --foreground CMD stays
# in the caller's group and only CMD is signalled.

set -u

usage() { echo "timeout: $1" >&2; exit 125; }

_secs() {
    # digits with at most one dot, then one optional s/m/h/d suffix
    local num="${1%[smhd]}" mult=1 int frac micro
    case "$num" in
        ''|*[!0-9.]*|*.*.*|.) return 1 ;;
    esac
    case "$1" in *m) mult=60 ;; *h) mult=3600 ;; *d) mult=86400 ;; esac
    # pure bash: a test fixture's stub PATH may hold no awk. Microsecond integers, bash 3.2-safe.
    int="${num%%.*}"; frac=""
    case "$num" in *.*) frac="${num#*.}" ;; esac
    frac="${frac}000000"; frac="${frac:0:6}"
    micro=$(( (10#${int:-0} * 1000000 + 10#$frac) * mult ))
    if [ $((micro % 1000000)) -eq 0 ]; then
        printf '%s' "$((micro / 1000000))"
    else
        printf '%d.%06d' "$((micro / 1000000))" "$((micro % 1000000))"
    fi
}

kill_after=0
sig=TERM
preserve=0
foreground=0
while [ $# -gt 0 ]; do
    case "$1" in
        --version) echo "timeout (himmel portable fallback)"; exit 0 ;;
        -k|--kill-after) [ $# -ge 2 ] || usage "option requires an argument -- 'k'"; kill_after="$2"; shift 2 ;;
        --kill-after=*) kill_after="${1#*=}"; shift ;;
        -k?*) kill_after="${1#-k}"; shift ;;
        -s|--signal) [ $# -ge 2 ] || usage "option requires an argument -- 's'"; sig="$2"; shift 2 ;;
        --signal=*) sig="${1#*=}"; shift ;;
        -s?*) sig="${1#-s}"; shift ;;
        --preserve-status) preserve=1; shift ;;
        --foreground) foreground=1; shift ;;
        -v|--verbose) shift ;;
        --) shift; break ;;
        -*) usage "unrecognized option '$1'" ;;
        *) break ;;
    esac
done
[ $# -ge 2 ] || usage "missing operand"

secs="$(_secs "$1")" || usage "invalid time interval '$1'"
kill_secs="$(_secs "$kill_after")" || usage "invalid time interval '$kill_after'"
shift
case "$sig" in [0-9]*) ;; *) sig="${sig#SIG}" ;; esac
kill -l "$sig" >/dev/null 2>&1 || usage "'$sig': invalid signal"

if [ "$secs" = "0" ]; then exec "$@"; fi

flag="$(mktemp "${TMPDIR:-/tmp}/portable-timeout.XXXXXX")" || usage "cannot create a state file"
trap 'rm -f "$flag" "$flag.done"' EXIT

if [ "$foreground" = 1 ]; then
    # the explicit <&0 stops bash redirecting an async command's stdin from /dev/null
    "$@" <&0 &
else
    set -m
    "$@" &
fi
pid=$!
set +m

# the watcher's stdio is detached: a lingering `sleep` must not hold the
# caller's pipe (e.g. `$(timeout ...)`) open past the command's exit
(
    sleep "$secs"
    [ -e "$flag.done" ] && exit 0
    echo term > "$flag"
    kill -s "$sig" -- "-$pid" 2>/dev/null || kill -s "$sig" "$pid" 2>/dev/null
    if [ "$kill_secs" != "0" ]; then
        sleep "$kill_secs"
        [ -e "$flag.done" ] && exit 0
        if kill -0 "$pid" 2>/dev/null; then
            echo kill > "$flag"
            kill -s KILL -- "-$pid" 2>/dev/null || kill -s KILL "$pid" 2>/dev/null
        fi
    fi
) >/dev/null 2>&1 </dev/null &
watcher=$!

got_sig=0
trap 'got_sig=1; kill -s TERM -- "-$pid" 2>/dev/null || kill -s TERM "$pid" 2>/dev/null' TERM
trap 'got_sig=1; kill -s INT -- "-$pid" 2>/dev/null || kill -s INT "$pid" 2>/dev/null' INT
rc=0
wait "$pid" 2>/dev/null || rc=$?
if [ "$got_sig" = 1 ]; then
    # a signal sent to this wrapper interrupted wait: keep waiting for CMD, escalating to KILL after -k like the bound does
    esc=""
    if [ "$kill_secs" != "0" ]; then
        ( sleep "$kill_secs"; kill -s KILL -- "-$pid" 2>/dev/null || kill -s KILL "$pid" 2>/dev/null ) >/dev/null 2>&1 </dev/null &
        esc=$!
    fi
    rc=0
    wait "$pid" 2>/dev/null || rc=$?
    if [ -n "$esc" ]; then pkill -P "$esc" 2>/dev/null; kill "$esc" 2>/dev/null; fi
fi
case "$(cat "$flag" 2>/dev/null)" in '') : > "$flag.done" ;; esac
pkill -P "$watcher" 2>/dev/null
kill "$watcher" 2>/dev/null
wait "$watcher" 2>/dev/null

case "$(cat "$flag" 2>/dev/null)" in
    kill) exit 137 ;;
    term) [ "$preserve" = 1 ] || rc=124 ;;
esac
exit "$rc"
