#!/usr/bin/env bash
# himmel-secrets — the one resolver for himmel's secret-class keys.
#
# Backend order for each requested NAME:
#   1. the process environment, when set and non-empty
#   2. $CREDENTIALS_DIRECTORY/<NAME>, set inside a systemd unit that declares
#      LoadCredential= or LoadCredentialEncrypted=
#   3. the OS keyring (Secret Service through secret-tool): first a
#      project-scoped item for the current checkout (service=himmel key=<NAME>
#      project=<primary checkout path>, so a worktree matches its primary),
#      then the user default (service=himmel key=<NAME> scope=user). The scope
#      attribute keeps libsecret's subset match from serving another project's
#      override as the default. Items live in the default collection.
#   4. legacy .env (load-dotenv.sh resolves which file), with one DEPRECATED
#      line naming the keys. A .env tracked by git serves no secret.
#   5. unset
#
# It never raises an unlock prompt: it reads the default collection's Locked
# property first (busctl, under timeout 2) and skips the keyring with one
# "keyring locked" line when it is locked; every secret-tool call runs under
# timeout 3. When DBUS_SESSION_BUS_ADDRESS is unset (cron), it uses
# <runtime dir>/bus, where the runtime dir is $HIMMEL_SECRETS_RUNTIME_DIR, else
# $XDG_RUNTIME_DIR, else /run/user/<uid>.
# HIMMEL_SECRETS_KEYRING=off skips the keyring step entirely.
#
# Verbs (a value is printed only by `get`, and handed on only by `exec`):
#   get [--root <dir>] [--no-dotenv] NAME...   print NAME=value for each found key
#   exec --keys NAME[,NAME...] [--root <dir>] -- CMD [ARG...]
#                                              run CMD with only those keys added
#   status [--root <dir>] [NAME...]            keyring state, then each NAME and
#                                              the layer serving it; with no NAME,
#                                              the himmel item names in the keyring
#   put [--project] [--root <dir>] [--stdin] NAME
#                                              store a value read from stdin (or a
#                                              silent TTY prompt)
#   import-env [--project] [--root <dir>] <file>
#                                              store every secret-class key of a
#                                              dotenv file; prints names only
#   export-env [--project] [--root <dir>] <file>
#                                              write the keyring's himmel items to a
#                                              new 0600 dotenv file
# --root <dir> picks the checkout (project id and .env) instead of the cwd.
# Exit: 0 ok, 1 nothing served (get/exec still run), 2 usage or keyring error.
set -uo pipefail

case "${BASH_SOURCE[0]}" in
    */*) _hs_dir=${BASH_SOURCE[0]%/*} ;;
    *) _hs_dir=. ;;
esac
# shellcheck source=load-dotenv.sh
. "$_hs_dir/load-dotenv.sh" || exit 2

_hs_die() { printf 'himmel-secrets: %s\n' "$*" >&2; exit 2; }

_hs_valid_name() {
    case "$1" in '' | [0-9]* | *[!A-Za-z0-9_]*) return 1 ;; esac
    return 0
}

# _hs_project_id [<dir>] — the primary checkout's physical path for <dir> (or
# the cwd), from git rev-parse --git-common-dir. Prints nothing outside git.
_hs_project_id() {
    local _hs_d="${1:-.}" _hs_common
    _hs_common=$(cd "$_hs_d" 2>/dev/null && git rev-parse --git-common-dir 2>/dev/null) || return 0
    [ -n "$_hs_common" ] || return 0
    (cd "$_hs_d" && cd "$_hs_common/.." 2>/dev/null && pwd -P) || return 0
}

_hs_find_bus() {
    [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] && return 0
    local _hs_rt="${HIMMEL_SECRETS_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-/run/user/$(id -u)}}"
    if [ -S "$_hs_rt/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=$_hs_rt/bus"
    fi
}

# _hs_keyring_state — sets HS_KEYRING once: off | unsupported | absent |
# unreachable | locked | unlocked. Prints the one "keyring locked" line.
HS_KEYRING=""
_hs_keyring_state() {
    [ -n "$HS_KEYRING" ] && return 0
    if [ "${HIMMEL_SECRETS_KEYRING:-}" = off ]; then HS_KEYRING=off; return 0; fi
    if [ "$(uname -s)" = Darwin ]; then
        # ponytail: Darwin skips the keyring, so a Mac serves secrets from
        # .env only. Upgrade path: a `security find-generic-password -s himmel
        # -a <NAME> -w` backend once a macOS runner can test it (HIMMEL-7147
        # follow-up).
        HS_KEYRING=unsupported; return 0
    fi
    if ! command -v secret-tool >/dev/null 2>&1 || ! command -v busctl >/dev/null 2>&1 \
        || ! command -v timeout >/dev/null 2>&1; then
        HS_KEYRING=absent; return 0
    fi
    _hs_find_bus
    local _hs_out _hs_rc
    _hs_out=$(timeout 2 busctl --user get-property org.freedesktop.secrets \
        /org/freedesktop/secrets/aliases/default org.freedesktop.Secret.Collection Locked 2>/dev/null)
    _hs_rc=$?
    case "$_hs_rc:$_hs_out" in
        "0:b false") HS_KEYRING=unlocked ;;
        "0:b true")
            HS_KEYRING=locked
            printf 'himmel-secrets: keyring locked (unlock the wallet or run himmel-secrets status)\n' >&2 ;;
        124:*)
            HS_KEYRING=unreachable
            printf 'himmel-secrets: keyring did not answer within 2 s; skipping it\n' >&2 ;;
        *) HS_KEYRING=absent ;;
    esac
}

# _hs_keyring_get NAME — sets HS_VAL and HS_LAYER from the keyring.
_hs_keyring_get() {
    local _hs_v
    if [ -n "$HS_PROJECT" ]; then
        _hs_v=$(timeout 3 secret-tool lookup service himmel key "$1" project "$HS_PROJECT" 2>/dev/null) || _hs_v=""
        if [ -n "$_hs_v" ]; then HS_VAL="$_hs_v"; HS_LAYER=keyring-project; return 0; fi
    fi
    _hs_v=$(timeout 3 secret-tool lookup service himmel key "$1" scope user 2>/dev/null) || _hs_v=""
    if [ -n "$_hs_v" ]; then HS_VAL="$_hs_v"; HS_LAYER=keyring; return 0; fi
    return 1
}

# _hs_dotenv_get NAME — sets HS_VAL and HS_LAYER from the legacy .env.
HS_TRACKED=""
_hs_dotenv_get() {
    local _hs_f _hs_line
    _hs_f=$(_load_dotenv_envfile "$HS_ROOT")
    [ -n "$_hs_f" ] && [ -f "$_hs_f" ] || return 1
    _hs_line=$(_load_dotenv_extract "$_hs_f" "$1")
    [ -n "$_hs_line" ] || return 1
    if [ -z "$HS_TRACKED" ]; then
        HS_TRACKED=0
        if _load_dotenv_tracked "$_hs_f"; then
            HS_TRACKED=1
            _himmel_tracked_dotenv_notice "$_hs_f"
        fi
    fi
    [ "$HS_TRACKED" = 0 ] || return 1
    HS_VAL=$(_load_dotenv_trim "${_hs_line#*=}")
    [ -n "$HS_VAL" ] || return 1
    HS_LAYER=dotenv
    HS_DOTENV_FILE="$_hs_f"
}

# _hs_resolve NAME — sets HS_VAL and HS_LAYER (env, credentials,
# keyring-project, keyring, dotenv, unset), walking the backend order.
_hs_resolve() {
    local _hs_n="$1" _hs_v
    HS_VAL=""; HS_LAYER="unset"
    if [ -n "${!_hs_n:-}" ]; then HS_VAL="${!_hs_n}"; HS_LAYER="env"; return 0; fi
    if [ -n "${CREDENTIALS_DIRECTORY:-}" ] && [ -f "$CREDENTIALS_DIRECTORY/$_hs_n" ]; then
        _hs_v=$(cat "$CREDENTIALS_DIRECTORY/$_hs_n" 2>/dev/null) || _hs_v=""
        if [ -n "$_hs_v" ]; then HS_VAL="$_hs_v"; HS_LAYER=credentials; return 0; fi
    fi
    _hs_keyring_state
    if [ "$HS_KEYRING" = unlocked ] && _hs_keyring_get "$_hs_n"; then return 0; fi
    if [ "$HS_DOTENV" = 1 ] && _hs_dotenv_get "$_hs_n"; then return 0; fi
    HS_VAL=""; HS_LAYER="unset"
    return 1
}

# A value must fit one KEY=value line.
_hs_one_line() {
    case "$HS_VAL" in
        *$'\n'*) printf 'himmel-secrets: %s holds a multi-line value; skipped\n' "$1" >&2; return 1 ;;
    esac
    return 0
}

_hs_require_unlocked() {
    _hs_keyring_state
    [ "$HS_KEYRING" = unlocked ] || _hs_die "the keyring is $HS_KEYRING; nothing was changed"
}

# _hs_store NAME VALUE
_hs_store() {
    if [ -n "$HS_SCOPE_PROJECT" ]; then
        printf '%s' "$2" | timeout 3 secret-tool store --label "himmel: $1 ($HS_SCOPE_PROJECT)" \
            service himmel key "$1" project "$HS_SCOPE_PROJECT"
    else
        printf '%s' "$2" | timeout 3 secret-tool store --label "himmel: $1" service himmel key "$1" scope user
    fi
}

# _hs_keyring_names — the key names of the himmel items in the chosen scope.
# secret-tool search prints each item's secret on stdout and its attribute
# lines on stderr, so only stderr is read. Returns 2 when the search failed or
# timed out (a search that matches nothing exits 0).
_hs_keyring_names() {
    local _hs_raw _hs_rc
    if [ -n "$HS_SCOPE_PROJECT" ]; then
        _hs_raw=$(timeout 3 secret-tool search --all service himmel project "$HS_SCOPE_PROJECT" 2>&1 >/dev/null)
    else
        _hs_raw=$(timeout 3 secret-tool search --all service himmel scope user 2>&1 >/dev/null)
    fi
    _hs_rc=$?
    [ "$_hs_rc" = 0 ] || return 2
    printf '%s\n' "$_hs_raw" | awk '/^attribute\.key = / { print substr($0, 17) }' | sort -u
}

HS_ROOT="" HS_DOTENV=1 HS_PROJECT="" HS_SCOPE_PROJECT="" HS_DOTENV_FILE=""
HS_VAL="" HS_LAYER=unset

verb="${1:-}"
[ -n "$verb" ] || _hs_die "usage: himmel-secrets get|exec|status|put|import-env|export-env ..."
shift

_hs_keys="" _hs_project_flag=0 _hs_stdin=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --root) [ "$#" -ge 2 ] || _hs_die "--root needs a directory"; HS_ROOT="$2"; shift 2 ;;
        --no-dotenv) HS_DOTENV=0; shift ;;
        --project) _hs_project_flag=1; shift ;;
        --stdin) _hs_stdin=1; shift ;;
        --keys) [ "$#" -ge 2 ] || _hs_die "--keys needs a list"; _hs_keys="$2"; shift 2 ;;
        --) shift; break ;;
        -*) _hs_die "unknown option: $1" ;;
        *) break ;;
    esac
done

HS_PROJECT=$(_hs_project_id "$HS_ROOT")
if [ "$_hs_project_flag" = 1 ]; then
    [ -n "$HS_PROJECT" ] || _hs_die "--project needs a git checkout (cwd or --root)"
    HS_SCOPE_PROJECT="$HS_PROJECT"
fi

case "$verb" in
    get)
        [ "$#" -gt 0 ] || _hs_die "usage: himmel-secrets get [--root <dir>] [--no-dotenv] NAME..."
        _hs_rc=1 _hs_dot=()
        for _hs_n in "$@"; do
            _hs_valid_name "$_hs_n" || _hs_die "not a key name: $_hs_n"
            _hs_resolve "$_hs_n" || continue
            _hs_one_line "$_hs_n" || continue
            printf '%s=%s\n' "$_hs_n" "$HS_VAL"
            [ "$HS_LAYER" = dotenv ] && _hs_dot[${#_hs_dot[@]}]="$_hs_n"
            _hs_rc=0
        done
        if [ "${#_hs_dot[@]}" -gt 0 ]; then _himmel_secret_dotenv_notice "$HS_DOTENV_FILE" "${_hs_dot[@]}"; fi
        exit "$_hs_rc"
        ;;
    exec)
        [ -n "$_hs_keys" ] && [ "$#" -gt 0 ] || _hs_die "usage: himmel-secrets exec --keys NAME[,NAME...] -- CMD [ARG...]"
        _hs_dot=()
        _hs_old_ifs=$IFS; IFS=,
        # shellcheck disable=SC2206 # split the comma list
        _hs_list=($_hs_keys)
        IFS=$_hs_old_ifs
        for _hs_n in "${_hs_list[@]}"; do
            _hs_valid_name "$_hs_n" || _hs_die "not a key name: $_hs_n"
            _hs_resolve "$_hs_n" || continue
            export "$_hs_n=$HS_VAL"
            [ "$HS_LAYER" = dotenv ] && _hs_dot[${#_hs_dot[@]}]="$_hs_n"
        done
        if [ "${#_hs_dot[@]}" -gt 0 ]; then _himmel_secret_dotenv_notice "$HS_DOTENV_FILE" "${_hs_dot[@]}"; fi
        exec "$@"
        ;;
    status)
        _hs_keyring_state 2>/dev/null
        printf 'keyring: %s\n' "$HS_KEYRING"
        if [ "$#" -gt 0 ]; then
            for _hs_n in "$@"; do
                _hs_valid_name "$_hs_n" || _hs_die "not a key name: $_hs_n"
                _hs_resolve "$_hs_n" 2>/dev/null
                printf '%s: %s\n' "$_hs_n" "$HS_LAYER"
            done
        elif [ "$HS_KEYRING" = unlocked ]; then
            if _hs_names=$(_hs_keyring_names); then
                [ -z "$_hs_names" ] || printf '%s\n' "$_hs_names" | sed 's/^/keyring item: /'
            else
                printf 'keyring items: the listing failed\n'
            fi
        fi
        HS_VAL=""
        exit 0
        ;;
    put)
        [ "$#" -eq 1 ] || _hs_die "usage: himmel-secrets put [--project] [--stdin] NAME"
        _hs_valid_name "$1" || _hs_die "not a key name: $1"
        _hs_require_unlocked
        if [ "$_hs_stdin" = 0 ] && [ -t 0 ]; then
            printf 'value for %s: ' "$1" >&2
            IFS= read -rs HS_VAL
            printf '\n' >&2
        else
            HS_VAL=$(cat)
        fi
        [ -n "$HS_VAL" ] || _hs_die "empty value; nothing stored"
        _hs_one_line "$1" || exit 2
        _hs_store "$1" "$HS_VAL" || _hs_die "secret-tool store failed for $1"
        printf 'stored %s\n' "$1"
        ;;
    import-env)
        [ "$#" -eq 1 ] || _hs_die "usage: himmel-secrets import-env [--project] <file>"
        [ -f "$1" ] || _hs_die "no such file: $1"
        _hs_require_unlocked
        _hs_n_ok=0
        # A line that is no key may be part of a multi-line value: name it by number only.
        while IFS="$(printf '\t')" read -r _hs_ln _hs_n; do
            [ -n "$_hs_n" ] || continue
            if ! _hs_valid_name "$_hs_n"; then printf 'skipped line %s (not a key name)\n' "$_hs_ln"; continue; fi
            _hs_class=$(_himmel_key_class "$_hs_n")
            if [ "$_hs_class" != secret ]; then
                printf 'skipped %s (%s key; it belongs in ~/.himmel)\n' "$_hs_n" "$_hs_class"; continue
            fi
            _hs_line=$(_load_dotenv_extract "$1" "$_hs_n")
            HS_VAL=$(_load_dotenv_trim "${_hs_line#*=}")
            if [ -z "$HS_VAL" ]; then printf 'skipped %s (empty)\n' "$_hs_n"; continue; fi
            _hs_store "$_hs_n" "$HS_VAL" || _hs_die "secret-tool store failed for $_hs_n"
            printf 'stored %s\n' "$_hs_n"
            _hs_n_ok=$((_hs_n_ok + 1))
        done <<EOF
$(awk '{ sub(/\r$/, ""); if ($0 == "" || $0 ~ /^[[:space:]]*#/ || index($0, "=") == 0) next
         k = substr($0, 1, index($0, "=") - 1); sub(/^[[:space:]]+/, "", k); sub(/[[:space:]]+$/, "", k)
         if (!(k in seen)) { seen[k] = 1; print NR "\t" k } }' "$1")
EOF
        HS_VAL=""
        printf 'imported %s key(s) into the keyring\n' "$_hs_n_ok"
        ;;
    export-env)
        [ "$#" -eq 1 ] || _hs_die "usage: himmel-secrets export-env [--project] <file>"
        [ ! -e "$1" ] || _hs_die "$1 exists; refusing to overwrite it"
        _hs_require_unlocked
        _hs_names=$(_hs_keyring_names) || _hs_die "the keyring listing failed or took over 3 s; nothing was written"
        _hs_out=$1
        # One exclusive open; every key goes through descriptor 3.
        umask 077
        set -C
        { exec 3>"$_hs_out"; } 2>/dev/null || _hs_die "cannot create $_hs_out"
        set +C
        _hs_n_ok=0 _hs_n_miss=0
        while IFS= read -r _hs_n; do
            _hs_valid_name "$_hs_n" || continue
            if [ -n "$HS_SCOPE_PROJECT" ]; then
                HS_VAL=$(timeout 3 secret-tool lookup service himmel key "$_hs_n" project "$HS_SCOPE_PROJECT" 2>/dev/null) || HS_VAL=""
            else
                HS_VAL=$(timeout 3 secret-tool lookup service himmel key "$_hs_n" scope user 2>/dev/null) || HS_VAL=""
            fi
            if [ -z "$HS_VAL" ] || ! _hs_one_line "$_hs_n"; then
                printf 'skipped %s (lookup failed)\n' "$_hs_n" >&2
                _hs_n_miss=$((_hs_n_miss + 1)); continue
            fi
            # The .env reader trims the ends and drops a " #" comment.
            case "$HS_VAL" in
                [[:space:]]*|*[[:space:]]|*[[:space:]]\#*)
                    printf 'skipped %s (the value would not read back from a .env)\n' "$_hs_n" >&2
                    _hs_n_miss=$((_hs_n_miss + 1)); continue ;;
            esac
            printf '%s=%s\n' "$_hs_n" "$HS_VAL" >&3 || { HS_VAL=""; _hs_die "cannot write $_hs_out"; }
            _hs_n_ok=$((_hs_n_ok + 1))
        done <<EOF
$_hs_names
EOF
        HS_VAL=""
        exec 3>&-
        _hs_mode=$(stat -c %a "$_hs_out" 2>/dev/null || stat -f %Lp "$_hs_out" 2>/dev/null)
        if [ "$_hs_mode" != 600 ]; then
            rm -f "$_hs_out"
            _hs_die "$_hs_out came out mode ${_hs_mode:-unknown}, not 600; removed it"
        fi
        printf 'wrote %s key(s) to %s (mode 0600)\n' "$_hs_n_ok" "$_hs_out"
        [ "$_hs_n_miss" = 0 ] || _hs_die "$_hs_n_miss keyring item(s) are missing from $_hs_out"
        ;;
    *)
        _hs_die "unknown verb: $verb (get|exec|status|put|import-env|export-env)"
        ;;
esac
