# escape-class-corpus.shapes — the shared escape-class corpus for every PreToolUse
# Bash guard (HIMMEL-5327). Read by scripts/hooks/test-escape-class-corpus.sh;
# a guard author may also read it to see the class a splitter must survive.
#
# WHY: five guard PRs on 2026-10-11 (2397, 2409 x2, 2411, 2413) each regressed on
# the SAME class — a hand-grown shell splitter that disagrees with bash on one
# corner — and each was caught only by a judge after a full review cycle.
#
# Every row is a shape where a naive splitter and bash DISAGREE, wrapped around
# one payload slot. In EVERY row bash still EXECUTES the payload at command
# position, so a guard that denies the plain payload (the control) must deny the
# shaped one too. A row never hides the payload inside a string, a comment or a
# heredoc body — that would make "allow" the correct answer.
#
# Format: <id>|||<what bash does>|||<template>
#   <NL>    a literal newline
#   @@P@@   the guard's whole protected payload (its control)
#   @@P1@@  the payload's first word        @@PR@@  the rest, after the first blank
#   @@PS@@  the payload with its first word split by backslash-newline after
#           its first character (bash joins it back: c\<NL>at == cat)
# A row using @@P1@@/@@PS@@ is skipped for a payload whose first word is a
# VAR=value assignment (the transform would change what runs).
#
# Policy (stated once): a guard that cannot parse a shape must FAIL CLOSED for a
# command that names its protected target. Allowing the shape is a bug.
plain-prefix-control|||no escape at all: an ordinary command, then the payload|||echo x; @@P@@
bs-newline-between-words|||backslash-newline joins the lines, payload words unchanged|||@@P1@@ \<NL>@@PR@@
bs-newline-inside-word|||backslash-newline inside the command word is removed|||@@PS@@
bs-escaped-quote|||an escaped quote is a literal, not a string opener|||echo \'; @@P@@
bs-escaped-dquote|||an escaped double quote is a literal|||echo \"; @@P@@
squote-trailing-backslash|||inside single quotes a backslash is literal and the quote closes|||echo 'a\'; @@P@@
dquote-escaped-backslash|||"a\\" closes at the second quote|||echo "a\\"; @@P@@
dquote-escaped-quote|||"a\"b" is one string|||echo "a\"b"; @@P@@
ansi-c-escaped-quote|||$'it\'s' is one string; the quote does not close it|||echo $'it\'s'; @@P@@
ansi-c-command-word|||$'cat' is the word cat|||$'@@P1@@' @@PR@@
hash-midword|||a # inside a word is not a comment|||echo a#b; @@P@@
hash-after-escaped-blank|||an escaped blank keeps the next # inside the word|||echo a\ #b; @@P@@
hash-after-escaped-operator|||an escaped ; is a literal, so the # is mid-word|||echo \;#b; @@P@@
comment-opens-fake-squote|||a real comment ends at the newline; its quote is text|||: # it's a comment<NL>@@P@@
comment-opens-fake-dquote|||a real comment ends at the newline; its quote is text|||: # say "hi<NL>@@P@@
heredoc-body-with-quote|||a quoted heredoc body is data; the payload follows the terminator|||cat <<'EOF'<NL>it's ; > here<NL>EOF<NL>@@P@@
heredoc-payload-on-opener-line|||the rest of the opener line still runs; the body is separate|||cat <<EOF; @@P@@<NL>body<NL>EOF
herestring-then-payload|||a here-string ends at its word|||cat <<< 'x'; @@P@@
herestring-with-quote|||a here-string word may hold an apostrophe|||cat <<< "it's"; @@P@@
quoted-herestring-operator|||a quoted <<< is a word, not an operator|||echo '<<<'; @@P@@
quoted-heredoc-operator|||a quoted << is a word, not a heredoc opener|||echo '<<EOF' && @@P@@
quoted-redirect-operator|||a quoted > is a word, not a redirect|||echo '>' && @@P@@
quoted-semicolon|||a quoted ; is a word|||echo ';' && @@P@@
quoted-pipe-and|||a quoted | and && are words|||echo '|' '&&' ; @@P@@
expansion-default-empty|||${V:-} expands to nothing; the command word is unchanged|||${V:-}@@P@@
expansion-strip-empty|||${V%x} of an unset V is empty|||${V%x}@@P@@
expansion-indirect-empty|||${!R} with R=Q and Q unset is empty (an unset R is a bash error)|||R=Q; ${!R}@@P@@
expansion-adjacent-empty|||$V${Z} of two unset names is empty|||$V${Z}@@P@@
expansion-empty-word|||an unset $V as its own word vanishes|||$V @@P@@
expansion-empty-arg|||${V:-} between words is an empty argument|||@@P1@@ ${V:-} @@PR@@
