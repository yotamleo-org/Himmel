{
  "$comment": "Output schema of compound-distill.sh's one claude -p run. Validated by the script's own subset checker: type, required, properties, additionalProperties, items, minItems, maxItems, enum, pattern, minLength.",
  "type": "object",
  "additionalProperties": false,
  "required": ["week", "entries", "themes", "proposals"],
  "properties": {
    "week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "outcome", "decision", "lesson"],
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" },
          "outcome": { "type": "string", "minLength": 1 },
          "decision": { "type": "string" },
          "lesson": { "type": "string" },
          "pr": { "type": "string" },
          "sha": { "type": "string" }
        }
      }
    },
    "themes": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "title", "lessons"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "keys"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "keys": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" }
                }
              }
            }
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "keys"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]+$" }
          }
        }
      }
    }
  }
}
