#!/usr/bin/env bash
# shellcheck disable=SC2016  # the jq programs are single-quoted on purpose: $n there is jq's, not the shell's
# Test shim for bun. An onboard.ts call is recorded to $RST/onboard.calls and units.log and
# answered from $RST/onboard.out (rc from $RST/onboard.rc). With $RST/onboard.hang it prints
# the nonce line, signals its parent with SIGINT (a Ctrl-C), then waits to be killed; its pid
# goes to $RST/onboard.pid so a test can check it is gone.
#
# A peer-bridge setup.ts call (add, confirm, remove) is recorded to $RST/setup.calls and units.log
# and stands in for the real verbs against the fixture HOME's peers.json (the same shape the real
# one writes), so no run touches Telegram:
#   add <peer> --peer-bot-id N --peer-username U --operator-bot-id M   writes the entry, chatId null
#   confirm <peer> <chatId>                                           sets chatId ($RST/setup.confirm.rc
#                                                                     non-zero: refuses with that code)
#   remove <peer>                                                     reads a line, needs "yes"; with
#                                                                     $RST/setup.remove.sigint it then
#                                                                     sends its parent a SIGINT
# With $RST/setup.real, `add` runs the REAL setup.ts ($RST_REAL_SETUP) instead.
# Anything else runs the real bun ($RST_REAL_BUN).
RST=${RST:?RST must point at the test dir}
case "$*" in
    *onboard.ts*)
        printf 'bun %s\n' "$*" >> "$RST/onboard.calls"
        printf 'onboard %s\n' "$*" >> "$RST/units.log"
        if [ -f "$RST/onboard.hang" ]; then
            [ -f "$RST/onboard.out" ] && head -n 1 "$RST/onboard.out"
            printf '%s' "$$" > "$RST/onboard.pid"
            kill -INT "$PPID"
            exec /bin/sleep 30
        fi
        [ -f "$RST/onboard.out" ] && cat "$RST/onboard.out"
        rc=0
        [ -f "$RST/onboard.rc" ] && rc=$(cat "$RST/onboard.rc")
        exit "$rc"
        ;;
    *setup.ts*)
        shift
        sub=${1:-}
        printf '%s\n' "$*" >> "$RST/setup.calls"
        printf 'setup %s\n' "$*" >> "$RST/units.log"
        if [ -f "$RST/setup.real" ] && [ "$sub" = add ]; then
            exec "${RST_REAL_BUN:?}" "${RST_REAL_SETUP:?}" "$@"
        fi
        peers=$HOME/.config/himmel/peer-bridge/peers.json
        name=${2:-}
        write_failed() {
            echo "setup: peers.json could not be written" >&2
            exit 1
        }
        # edit_peers <jq args...> <filter>: rewrites peers.json through a temp file; any failed step exits 1.
        edit_peers() {
            jq "$@" "$peers" > "$peers.new" || { rm -f "$peers.new"; write_failed; }
            mv "$peers.new" "$peers" || write_failed
            chmod 600 "$peers" || write_failed
        }
        case "$sub" in
            add)
                shift 2
                pid="" user=""
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --peer-bot-id) pid=$2 ;;
                        --peer-username) user=$2 ;;
                    esac
                    shift 2
                done
                mkdir -p "$(dirname "$peers")" || write_failed
                [ -f "$peers" ] || echo '{"operatorBotId":"0","operatorChatId":1,"bridgeRoot":"/x","himmelRoot":"/y","peers":{},"maxTextChars":4000,"addressing":"command"}' > "$peers" || write_failed
                edit_peers --arg n "$name" --arg b "$pid" --arg u "$user" '.peers[$n] = {peerBotId: $b, chatId: null, allowFrom: [$b], theirs: {username: $u}}'
                echo "added $name"
                ;;
            confirm)
                if [ -f "$RST/setup.confirm.rc" ]; then
                    echo "setup: our bot (222) has the right can_delete_messages; promote it to administrator with every right off first" >&2
                    exit "$(cat "$RST/setup.confirm.rc")"
                fi
                edit_peers --arg n "$name" --argjson c "$3" '.peers[$n].chatId = $c'
                echo "confirmed $name"
                ;;
            remove)
                read -r ans
                if [ "$ans" != yes ]; then echo "setup: not removed" >&2; exit 3; fi
                edit_peers --arg n "$name" 'del(.peers[$n])'
                echo "removed $name; restart the poller to drop it"
                if [ -f "$RST/setup.remove.sigint" ]; then kill -INT "$PPID"; fi
                ;;
            *) exit 2 ;;
        esac
        exit 0
        ;;
    *)
        exec "${RST_REAL_BUN:?}" "$@"
        ;;
esac
