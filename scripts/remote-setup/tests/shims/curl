#!/usr/bin/env bash
# Test shim for curl. Records argv and the stdin config, serves canned Telegram JSON.
# Layout under $RST/tg: <method>.json (default answer), <method>.<n>.json (the n-th call),
# <method>.curl_exit (a transport failure: print nothing, exit with that code).
RST=${RST:?RST must point at the test dir}
printf '%s\n' "$*" >> "$RST/curl.argv"
cfg=$(cat)
printf '%s\n---\n' "$cfg" >> "$RST/curl.stdin"
url=$(printf '%s\n' "$cfg" | sed -n 's/^url = "\(.*\)"$/\1/p' | head -n 1)
method=${url##*/}
method=${method%%\?*}
d=$RST/tg
n=0
[ -f "$d/$method.n" ] && n=$(cat "$d/$method.n")
n=$((n + 1))
printf '%s' "$n" > "$d/$method.n"
if [ -f "$d/$method.curl_exit" ]; then
    exit "$(cat "$d/$method.curl_exit")"
fi
if [ -f "$d/$method.$n.json" ]; then
    cat "$d/$method.$n.json"
elif [ -f "$d/$method.json" ]; then
    cat "$d/$method.json"
else
    printf '{"ok":false,"error_code":404,"description":"Not Found"}'
fi
exit 0
