# systemd user unit for the peer bridge runner (serving side). setup.ts runner
# installs it, with @HIMMEL_ROOT@ replaced, only while some peer serves
# run-suite. It reads no env file: the runner holds no bot token and no key.
[Unit]
Description=himmel peer bridge runner
After=himmel-peer-bridge.service

[Service]
Type=simple
Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
Environment=PEER_JOB_BACKEND=vbox
ExecStart=/usr/bin/env bun @HIMMEL_ROOT@/scripts/peer-bridge/runner.ts
Restart=on-failure
RestartSec=30
NoNewPrivileges=yes

[Install]
WantedBy=default.target
