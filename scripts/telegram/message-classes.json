{
  "cap": 400,
  "kinds": [
    {
      "kind": "merge-blocked",
      "class": "escalate",
      "sender": "scripts/lib/merge-block-alert.sh",
      "sample": "Merge refused: PR 4882 in octo/demo. Blocks: the merge after GO. Do: ask a reviewer for the one approval GitHub still wants"
    },
    {
      "kind": "token-in-output",
      "class": "escalate",
      "sender": "scripts/hooks/detect-token-in-output.sh",
      "sample": "A credential leaked: a GitHub token appeared in session 81843b5d. Blocks: nothing yet, it is in the transcript. Do: rotate the GitHub token"
    },
    {
      "kind": "config-audit",
      "class": "escalate",
      "sender": "scripts/lib/config-audit.sh",
      "sample": "A session changed .env: JIRA_API_TOKEN. Blocks: nothing. Do: check it was you, else restore the file from its backup"
    },
    {
      "kind": "hold-ask-operator",
      "class": "escalate",
      "sender": "scripts/handover/chief-kit/chief-wait.sh",
      "sample": "A worker on a ticket needs a settings or CI file: .github/workflows/ci.yml. Blocks: that worker. Do: in a real terminal, run: bash scripts/handover/chief-kit/go.sh grant the-ticket"
    },
    {
      "kind": "hold-ask-stuck",
      "class": "escalate",
      "sender": "scripts/handover/chief-kit/chief-wait.sh",
      "sample": "A file ask waited 30 min: a worker wants scripts/cr/critic-panel.sh, held by another ticket. Blocks: that worker. Do: in a real terminal, run: bash scripts/handover/chief-kit/go.sh grant the-ticket"
    },
    {
      "kind": "denial-stuck",
      "class": "escalate",
      "sender": "scripts/handover/chief-kit/chief-wait.sh",
      "sample": "A worker N4992b has been parked 30 min by a classifier denial (PAUSE-RISK). Blocks: its ticket. Do: open the session in Remote Control, or run ack-denial.sh with the label"
    },
    {
      "kind": "monitor-chat-down",
      "class": "escalate",
      "sender": "scripts/telegram/poller.ts",
      "pin": "replyViaOutbox(root, chat, monitorChatDownText(",
      "sample": "The monitoring group is getting no messages (unset); 3 are kept on the station. Blocks: routine monitoring only. Do: check the two monitoring lines in the bridge env file and that the monitoring bot is in its group, then restart the bridge"
    },
    {
      "kind": "recover-failed",
      "class": "escalate",
      "sender": "scripts/station-ops/recover.sh",
      "sample": "Reboot recovery failed: the bridge did not come back. Blocks: every Telegram message. Do: run systemctl --user restart telegram-bridge.service"
    },
    {
      "kind": "chief-reply",
      "class": "escalate",
      "sender": "docs/handover/running-a-chief.md",
      "cap": "none"
    },
    {
      "kind": "hold-ask-chief",
      "class": "escalate",
      "sender": "scripts/handover/chief-kit/chief-wait.sh",
      "sample": "A worker wants scripts/cr/critic-panel.sh, held by another ticket. Blocks: that worker. Do: in a real terminal, run: bash scripts/handover/chief-kit/go.sh grant the-ticket"
    },
    {
      "kind": "denial-page",
      "class": "escalate",
      "sender": "scripts/handover/chief-kit/chief-wait.sh",
      "sample": "Session 81843b5d of the himmel chief has 3 classifier denials (PAUSE-RISK). Blocks: that session. Do: open it in Remote Control and answer the prompt"
