      },
      "diamond": [
        500,
        470,
        36,
        46
      ],
      "what": "One gate sees everything the earlier steps produced: CI on this exact commit, the reviewers and CodeRabbit's review threads. Any `gh pr merge` Claude tries goes through it. It refuses on what it can read; a failed read lets the merge through with a warning, except in a clone armed with the CodeRabbit app, where an unreadable review ledger holds every required reviewer and a failed CodeRabbit read holds a required CodeRabbit review.",
      "loop": [
        "Claude asks to merge",
        "The gate reads CI, the reviewers and CodeRabbit's threads",
        "Any no: back to that step",
        "All yes: on to approval"
      ],
      "chains": [
        {
